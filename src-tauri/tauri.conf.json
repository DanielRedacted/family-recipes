{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recipes",
  "version": "0.1.0",
  "identifier": "family.recipes.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Lifestyle",
    "shortDescription": "The family cookbook",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "12.0" }
  }
}
